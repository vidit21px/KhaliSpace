rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function kycOf(uid) { return get(/databases/$(database)/documents/kyc/$(uid)).data; }
    function verified(uid) { return kycOf(uid).status == 'verified'; }
    function threadOf(tid) { return get(/databases/$(database)/documents/threads/$(tid)).data; }
    function listingOf(id) { return get(/databases/$(database)/documents/listings/$(id)).data; }

    // Admins are created by hand in the Firebase console, never from the app.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // Private profile (phone). Only the owner can read or write it.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // KYC: the driver submits (always as "pending"); only an admin can approve/reject.
    match /kyc/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
                            && request.resource.data.status == 'pending';
      allow update: if isAdmin();
    }

    // Listings: anyone can browse. Truck listings need a verified driver and the verified plate number.
    match /listings/{id} {
      function truckOk() {
        let k = kycOf(request.auth.uid);
        return k.status == 'verified' && request.resource.data.vehicleNo == k.vehicleNo;
      }
      // After a confirmed deal either person in that chat may close the listings;
      // if the deal is cancelled, they can be reopened.
      function bookingToggle() {
        let nd = request.resource.data;
        let t = threadOf(nd.bookedThread);
        return nd.diff(resource.data).affectedKeys().hasOnly(['status', 'bookedThread'])
          && request.auth.uid in t.participants
          && resource.data.ownerId in t.participants
          && ((nd.status == 'booked' && t.get('dealStatus', 'none') == 'confirmed')
              || (nd.status == 'open' && t.get('dealStatus', 'none') == 'cancelled'));
      }

      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.expiresAt is number
                    && (request.resource.data.role != 'truck' || truckOk());
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId)
        || bookingToggle());
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Chat threads and deal state: only the two participants.
    // A thread needs a VERIFIED DRIVER: on a load listing the driver is whoever opens the chat.
    match /threads/{tid} {
      function validNewThread() {
        let t = request.resource.data;
        let l = listingOf(t.listingId);
        return t.driverId in t.participants
          && l.ownerId in t.participants
          && (l.role != 'load' || t.driverId == request.auth.uid)
          && (l.role != 'truck' || t.driverId == l.ownerId)
          && verified(t.driverId);
      }

      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.get('dealStatus', 'none') == 'none'
                    && validNewThread();
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && request.resource.data.get('listingId', '') == resource.data.get('listingId', '')
                    && verified(resource.data.driverId)
                    // a deal can only be confirmed by the person who did NOT propose it
                    && (request.resource.data.get('dealStatus', 'none') != 'confirmed'
                        || resource.data.get('dealStatus', 'none') == 'confirmed'
                        || (resource.data.get('dealStatus', 'none') == 'proposed'
                            && resource.data.get('dealBy', '') != request.auth.uid))
                    // dealBy can only be set to yourself, when you make a proposal
                    && (request.resource.data.get('dealBy', '') == resource.data.get('dealBy', '')
                        || (request.resource.data.get('dealStatus', 'none') == 'proposed'
                            && request.resource.data.dealBy == request.auth.uid));

      match /messages/{mid} {
        function threadOk() {
          let t = threadOf(tid);
          return request.auth.uid in t.participants && verified(t.driverId);
        }
        allow read: if signedIn() && request.auth.uid in threadOf(tid).participants;
        allow create: if signedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && threadOk();
      }
    }
  }
}
